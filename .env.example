# Copy to .env and fill in. Every provider below has a free tier.

# --- LLMs (talker / planner / judge) ---
CEREBRAS_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=            # Google AI Studio (Gemini: vision + judge)
OLLAMA_BASE_URL=http://localhost:11434   # local simulator rep (qwen3)

# --- Speech ---
DEEPGRAM_API_KEY=          # STT + TTS ($200 free credit)

# --- Observability ---
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=vocalis

# --- Model choices (override to swap providers) ---
VOCALIS_TALKER_MODELS=cerebras/gpt-oss-120b,groq/openai/gpt-oss-120b,gemini/gemini-flash-lite-latest
VOCALIS_PLANNER_MODELS=gemini/gemini-flash-latest,cerebras/gpt-oss-120b
VOCALIS_JUDGE_MODELS=gemini/gemini-flash-lite-latest,groq/openai/gpt-oss-120b
VOCALIS_REP_MODELS=ollama_chat/qwen3:8b,groq/openai/gpt-oss-20b
VOCALIS_VISION_MODEL=gemini-flash-latest
